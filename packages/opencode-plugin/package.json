{
  "name": "opencode-rehydar",
  "version": "0.14.2",
  "description": "Rehydra OpenCode plugin — anonymizes secrets in LLM context using native plugin hooks",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "imports": {
    "#storage": {
      "node": "./dist/utils/storage.js",
      "default": "./dist/utils/storage.js"
    },
    "#onnx-runtime": {
      "node": "./dist/ner/onnx-runtime.js",
      "default": "./dist/ner/onnx-runtime.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "dist/",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "prepublishOnly": "node ./scripts/sync-dist.mjs"
  },
  "keywords": [
    "anonymization",
    "pii",
    "privacy",
    "secrets",
    "opencode",
    "opencode-plugin",
    "rehydra"
  ],
  "author": "EightDoor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EightDoor/opencode-rehydra-sdk.git",
    "directory": "packages/opencode-plugin"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
